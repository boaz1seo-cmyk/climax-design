---
{% import "macros/custom-icons.njk" as icons %}
{% import "macros/lead-strip.njk" as leadStripMacro %}
{% set t = i18n.he %}

<section class="hero hero--page">
  <div class="hero__inner">
    <div class="eyebrow" data-animate>קידום במדיה</div>
    <h1 class="display-heading" style="font-size: var(--step-h1);" data-animate>קידום ממומן בפייסבוק, אינסטגרם וגוגל</h1>
    <p class="prose" style="font-size: var(--step-body-lg);" data-animate>
      ניהול קמפיינים ממומנים מקצה לקצה: בניית אסטרטגיית מדיה ומשפכי המרה, פילוח קהלים מדויק ורימרקטינג, קריאייטיב ייעודי לכל פלטפורמה, קופי שממיר, A/B טסטינג שיטתי, אופטימיזציה שוטפת ודוחות ביצועים שקופים.
    </p>
    <a class="btn btn-primary" href="/contact/" data-animate>{{ t.cta.contactButton }} <span class="btn-arrow" aria-hidden="true">←</span></a>
  </div>
</section>

{{ leadStripMacro.leadStrip("he", business, t, "media") }}

<section class="room room--light">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-animate>פייסבוק ואינסטגרם</span>
      <h2 class="display-heading" style="font-size: var(--step-h1);" data-animate>קידום ממומן שמדבר לקהל הנכון</h2>
    </div>
    <div class="feature-grid feature-grid--3" data-animate-group>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.funnelIcon() }}</span>
        <h3 class="feature__title">אסטרטגיית מדיה ומשפכי המרה</h3>
        <p class="feature__body">בונים מסע לקוח שלם, מהחשיפה הראשונה ועד להמרה — לא רק קמפיין בודד.</p>
      </div>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.audienceIcon() }}</span>
        <h3 class="feature__title">פילוח קהלים ורימרקטינג</h3>
        <p class="feature__body">מיקוד מדויק בקהלי היעד הרלוונטיים, וחזרה אל מי שכבר הביע עניין.</p>
      </div>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.platformCreativeIcon() }}</span>
        <h3 class="feature__title">קריאייטיב ייעודי לכל פלטפורמה</h3>
        <p class="feature__body">עיצוב ווידאו שמותאמים לשפה ולפורמט של כל רשת — לא באנר אחד לכולם.</p>
      </div>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.copyIcon() }}</span>
        <h3 class="feature__title">קופי שממיר</h3>
        <p class="feature__body">כתיבה שיווקית שמדברת בשפת הלקוח ומניעה לפעולה.</p>
      </div>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.abTestIcon() }}</span>
        <h3 class="feature__title">A/B טסטינג שיטתי</h3>
        <p class="feature__body">בדיקה מתמדת של קריאייטיבים, קהלים והצעות — ההחלטות מבוססות נתונים, לא ניחושים.</p>
      </div>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.reportsIcon() }}</span>
        <h3 class="feature__title">דוחות ביצועים שקופים</h3>
        <p class="feature__body">אופטימיזציה שוטפת ודיווח ברור, כדי שתמיד תדעו איפה עומד הכסף שלכם.</p>
      </div>
    </div>
  </div>
</section>

<section class="room">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-animate>גוגל</span>
      <h2 class="display-heading" style="font-size: var(--step-h1);" data-animate>קידום בגוגל שמביא תוצאה</h2>
      <p class="prose" data-animate>קמפיינים בחיפוש, בשופינג, ברשת המדיה וביוטיוב — ממוקדי תוצאה ועלות-המרה.</p>
    </div>
    <div class="feature-grid feature-grid--3" data-animate-group>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.searchIcon() }}</span>
        <h3 class="feature__title">חיפוש (Search)</h3>
        <p class="feature__body">הופעה בדיוק ברגע שבו לקוחות פוטנציאליים מחפשים אתכם.</p>
      </div>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.shoppingIcon() }}</span>
        <h3 class="feature__title">שופינג (Shopping)</h3>
        <p class="feature__body">הצגת מוצרים ישירות בתוצאות החיפוש, לחנויות אונליין.</p>
      </div>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.networkIcon() }}</span>
        <h3 class="feature__title">רשת המדיה ויוטיוב</h3>
        <p class="feature__body">חשיפה ובניית מודעות מותג באתרים וסרטונים ברחבי הרשת.</p>
      </div>
    </div>
  </div>
</section>

<section class="room room--light">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-animate>רשתות חברתיות</span>
      <h2 class="display-heading" style="font-size: var(--step-h1);" data-animate>ניהול נוכחות דיגיטלית מלאה</h2>
      <p class="prose" data-animate>אסטרטגיית תוכן, קונספטים ולוחות תוכן חודשיים, עיצוב פוסטים וסטוריז, כתיבת קופי, וניהול קהילה — נוכחות עקבית שבונה מותג ומייצרת פניות.</p>
    </div>
  </div>
</section>

<section class="room room--white">
  <div class="container center-col">
    <h2 class="display-heading" style="font-size: var(--step-h1); max-width: 40rem;" data-animate>מוכנים להגדיל את הפעילות הממומנת שלכם?</h2>
    <a class="btn btn-primary" style="margin-block-start: var(--space-lg);" href="/contact/" data-animate>{{ t.cta.contactButton }} <span class="btn-arrow" aria-hidden="true">←</span></a>
  </div>
</section>
