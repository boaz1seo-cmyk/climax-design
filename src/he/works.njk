---
layout: layouts/base.njk
lang: he
dir: rtl
navActive: works
permalink: /works/index.html
title: "עבודות נבחרות | מיתוג, UI, עיצוב גרפי ואתרים — Climax Design"
description: "גלריית עבודות נבחרות של Climax Design: פרויקטי מיתוג, עיצוב UI, עיצוב גרפי ועיצוב אתרים עבור לקוחות הייטק, מזון, מלונאות ואירועים."
---
{% import "macros/work-card.njk" as cards %}
{% import "macros/lead-strip.njk" as leadStripMacro %}
{% set t = i18n.he %}

<section class="hero hero--page">
  <div class="hero__inner">
    <div class="eyebrow" data-animate>תיק העבודות</div>
    <h1 class="display-heading" style="font-size: var(--step-h1);" data-animate>עבודות מיתוג ועיצוב נבחרות</h1>
    <p class="prose" data-animate>מיתוג, עיצוב UI, עיצוב גרפי ועיצוב אתרים — מבחר מהפרויקטים שלנו לאורך השנים.</p>
  </div>
</section>

{{ leadStripMacro.leadStrip("he", business, t, "works") }}

<section class="room room--light">
  <div class="container">
    <div class="filter-bar" data-filter-bar role="group" aria-label="סינון עבודות לפי קטגוריה">
      <button class="filter-btn" type="button" data-category="all" aria-pressed="true">{{ t.categories.all }}</button>
      <button class="filter-btn" type="button" data-category="branding-design" aria-pressed="false">{{ t.categories['branding-design'] }}</button>
      <button class="filter-btn" type="button" data-category="digital-web" aria-pressed="false">{{ t.categories['digital-web'] }}</button>
      <button class="filter-btn" type="button" data-category="campaigns" aria-pressed="false">{{ t.categories.campaigns }}</button>
      <button class="filter-btn" type="button" data-category="ai-video" aria-pressed="false">{{ t.categories['ai-video'] }}</button>
    </div>

    <div class="work-grid" data-work-grid data-animate-group>
      {% for work in works %}{{ cards.workCard(work, "he", t, "/") }}{% endfor %}
    </div>
  </div>
</section>

<section class="room room--white">
  <div class="container center-col">
    <h2 class="display-heading" style="font-size: var(--step-h1); max-width: 40rem;" data-animate>{{ t.cta.letsTalk }}</h2>
    <a class="btn btn-primary" style="margin-block-start: var(--space-lg);" href="/contact/" data-animate>{{ t.cta.contactButton }} <span class="btn-arrow" aria-hidden="true">←</span></a>
  </div>
</section>
