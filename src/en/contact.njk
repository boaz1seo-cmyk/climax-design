---
layout: layouts/base.njk
lang: en
dir: ltr
navActive: contact
permalink: /en/contact/index.html
title: "Contact Us | Climax Design — Boutique Agency, Ramat Gan"
description: "Ready to start a branding, design or digital advertising project? Fill out the form or message us directly on WhatsApp — we'll get back to you within one business day."
---
{% import "macros/custom-icons.njk" as icons %}
{% import "macros/lead-strip.njk" as leadStripMacro %}
{% set t = i18n.en %}

<section class="hero hero--page">
  <div class="hero__inner">
    <div class="eyebrow" data-animate>Contact</div>
    <h1 class="display-heading" style="font-size: var(--step-h1);" data-animate>Let's talk about your project</h1>
    <p class="prose" data-animate>Fill in your details and we'll get back to you shortly — usually within one business day.</p>
  </div>
</section>

{{ leadStripMacro.leadStrip("en", business, t, "contact-top") }}

<section class="room room--white">
  <div class="container">
    <div class="form-status" data-form-status role="status" aria-live="polite"></div>

    <form class="form-grid" data-contact-form novalidate>
      <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off">
      <input type="hidden" name="access_key" value="{{ business.web3forms.accessKey }}">
      <input type="hidden" name="subject" value="New inquiry from the Climax Design website">
      <input type="hidden" name="from_name" value="Contact form — climax-design.co.il">
      <input type="hidden" name="redirect" value="{{ business.url }}/en/thank-you/">

      <div class="form-field">
        <label for="name-en">{{ t.form.name }} <span aria-hidden="true">*</span></label>
        <input type="text" id="name-en" name="name" placeholder="{{ t.form.namePlaceholder }}" required autocomplete="name">
        <span class="form-error" role="alert"></span>
      </div>

      <div class="form-field">
        <label for="phone-en">{{ t.form.phone }} <span aria-hidden="true">*</span></label>
        <input type="tel" id="phone-en" name="phone" placeholder="{{ t.form.phonePlaceholder }}" required autocomplete="tel">
        <span class="form-error" role="alert"></span>
      </div>

      <div class="form-field">
        <label for="email-en">{{ t.form.email }} <span aria-hidden="true">*</span></label>
        <input type="email" id="email-en" name="email" placeholder="{{ t.form.emailPlaceholder }}" required autocomplete="email">
        <span class="form-error" role="alert"></span>
      </div>

      <div class="form-field">
        <label for="projectType-en">{{ t.form.projectType }} <span aria-hidden="true">*</span></label>
        <select id="projectType-en" name="project_type" required>
          <option value="" disabled selected>{{ t.form.projectTypePlaceholder }}</option>
          {% for key, label in t.form.projectTypes %}
          <option value="{{ key }}">{{ label }}</option>
          {% endfor %}
        </select>
        <span class="form-error" role="alert"></span>
      </div>

      <div class="form-field form-field--full">
        <label for="budget-en">{{ t.form.budget }}</label>
        <select id="budget-en" name="budget">
          <option value="" disabled selected>{{ t.form.budgetPlaceholder }}</option>
          {% for key, label in t.form.budgets %}
          <option value="{{ key }}">{{ label }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="form-field form-field--full">
        <label for="message-en">{{ t.form.message }} <span aria-hidden="true">*</span></label>
        <textarea id="message-en" name="message" placeholder="{{ t.form.messagePlaceholder }}" required></textarea>
        <span class="form-error" role="alert"></span>
      </div>

      <div class="form-field form-field--full">
        <button class="btn btn-primary" type="submit">{{ t.form.submit }}</button>
      </div>
    </form>
  </div>
</section>

<section class="room room--light contact-icons-section">
  <div class="container">
    <div class="contact-info-row" data-animate-group>
      <a href="tel:{{ business.phoneE164 }}" class="feature contact-icons__link" data-animate-item aria-label="Call us — {{ business.phoneDisplay }}">
        <span class="feature__icon">{{ icons.phoneIcon() }}</span>
        <span class="eyebrow">Phone</span>
      </a>
      <a href="mailto:{{ business.email }}" class="feature contact-icons__link" data-animate-item aria-label="Email us — {{ business.email }}">
        <span class="feature__icon">{{ icons.mailIcon() }}</span>
        <span class="eyebrow">Email</span>
      </a>
      <a href="https://waze.com/ul?q={{ (business.address.en.street + ' ' + business.address.en.city) | urlencode }}" target="_blank" rel="noopener" class="feature contact-icons__link" data-animate-item aria-label="Open in Waze — {{ business.address.en.street }}, {{ business.address.en.city }}">
        <span class="feature__icon">{{ icons.mapPinIcon() }}</span>
        <span class="eyebrow">Address</span>
      </a>
      <a href="https://wa.me/{{ business.whatsapp }}?text={{ t.whatsapp.defaultMessage | urlencode }}" target="_blank" rel="noopener" class="feature contact-icons__link" data-animate-item aria-label="Message us on WhatsApp">
        <span class="feature__icon">{% whatsappIcon 28 %}</span>
        <span class="eyebrow">WhatsApp</span>
      </a>
    </div>

    {% if business.social.instagram or business.social.facebook or business.social.tiktok %}
    <hr class="contact-icons__divider">
    <p class="contact-icons__follow-heading">Follow us</p>
    <div class="contact-social-row" data-animate-group>
      {% if business.social.tiktok %}
      <a href="{{ business.social.tiktok }}" target="_blank" rel="noopener" class="feature contact-icons__link" data-animate-item aria-label="TikTok of Climax Design">
        <span class="feature__icon">{% tiktokIcon 36 %}</span>
      </a>
      {% endif %}
      {% if business.social.facebook %}
      <a href="{{ business.social.facebook }}" target="_blank" rel="noopener" class="feature contact-icons__link" data-animate-item aria-label="Facebook of Climax Design">
        <span class="feature__icon">{% facebookIcon 36 %}</span>
      </a>
      {% endif %}
      {% if business.social.instagram %}
      <a href="{{ business.social.instagram }}" target="_blank" rel="noopener" class="feature contact-icons__link" data-animate-item aria-label="Instagram of Climax Design">
        <span class="feature__icon">{% instagramIcon 36 %}</span>
      </a>
      {% endif %}
    </div>
    {% endif %}
  </div>
</section>
