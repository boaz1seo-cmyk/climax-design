  "@type": "ProfessionalService"
  "name": "Climax Design"
  "url": "https://climax-design.co.il/en/"
  "telephone": "+972522908725"
  "email": "boaz@climax-design.co.il"
  "priceRange": "$$"
  "founder":
    "@type": "Person"
    "name": "Boaz Levkovitch"
  "address":
    "@type": "PostalAddress"
    "streetAddress": "33 Jabotinsky St., Twin Towers, Bursa Complex"
    "addressLocality": "Ramat Gan"
    "addressCountry": "IL"
  "geo":
    "@type": "GeoCoordinates"
    "latitude": 32.0824
    "longitude": 34.8115
  "areaServed": "IL"
  "review":
    - "@type": "Review"
      "reviewBody": "Extremely happy: with the speed of response, the creative, the campaigns, and of course the growing number of bookings!"
      "author":
        "@type": "Organization"
        "name": "Carmel Maternity Hotel"
    - "@type": "Review"
      "reviewBody": "Incredibly talented, and a real pleasure to work with. Highly recommend!"
      "author":
        "@type": "Person"
        "name": "Limor Garber"
    - "@type": "Review"
      "reviewBody": "A very professional, attentive studio with a wide range of capabilities. Highly recommended."
      "author":
        "@type": "Person"
        "name": "Roy Arbel"
    - "@type": "Review"
      "reviewBody": "A very professional studio with excellent service. We've worked with them for years. Highly recommend."
      "author":
        "@type": "Organization"
        "name": "Test InSight"
    - "@type": "Review"
      "reviewBody": "I went through a few ad agencies before I found Boaz. From the very first conversation I knew I was dealing with a professional. The sponsored posts brought responses, and most importantly: money in the till. Available for any question or request."
      "author":
        "@type": "Person"
        "name": "Galit Yaakobi"
---
{% import "macros/work-card.njk" as cards %}
{% import "macros/lead-strip.njk" as leadStripMacro %}
{% import "partials/client-marquee.njk" as marqueeMacro %}
{% import "macros/custom-icons.njk" as icons %}
{% set t = i18n.en %}

<section class="hero hero--video">
  <div class="hero__media" aria-hidden="true">
    <video autoplay muted loop playsinline poster="/assets/video/showreel-poster.jpg">
      <source src="/assets/video/showreel.webm" type="video/webm">
      <source src="/assets/video/showreel.mp4" type="video/mp4">
    </video>
  </div>
  <div class="hero__inner">
    <h1 class="hero__headline">
      <span class="hero__headline-line display-heading is-active" data-headline-line>Creative that moves people.</span>
      <span class="hero__headline-line display-heading" data-headline-line>Branding people remember.</span>
      <span class="hero__headline-line display-heading" data-headline-line>Digital Advertising That Delivers.</span>
    </h1>
    <a class="btn btn-primary" href="/en/contact/" data-animate>
      Let's make something remarkable together
      <span class="btn-arrow" aria-hidden="true">→</span>
    </a>
  </div>
  <div class="hero__scrollcue" aria-hidden="true"><span></span></div>
</section>

{{ leadStripMacro.leadStrip("en", business, t, "home") }}

<section class="room room--charcoal">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-animate>What we do</span>
      <h2 class="display-heading" style="font-size: var(--step-h1);" data-animate>Services that build a complete brand</h2>
      <p class="prose" data-animate>A boutique agency offering creative, branding and media advertising across every channel, under one roof. A dedicated, service-minded team, with personal attention to every client.</p>
    </div>

    <div class="feature-grid" data-animate-group>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.brandStrategyIcon() }}</span>
        <span class="feature__index">01</span>
        <h3 class="feature__title">Branding &amp; Strategy</h3>
        <p class="feature__body">Building a brand from scratch or refreshing an existing one — research, differentiation, a full visual language and a proper brand book.</p>
        <a class="btn btn-ghost" href="/en/works/?category=branding-design">{{ t.cta.readMore }} <span class="btn-arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.graphicDigitalIcon() }}</span>
        <span class="feature__index">02</span>
        <h3 class="feature__title">Graphic &amp; Digital</h3>
        <p class="feature__body">UI design for websites and apps, converting landing pages, visual social campaigns and packaging — Bezalel-grade craft, boutique-grade precision.</p>
        <a class="btn btn-ghost" href="/en/works/">{{ t.cta.readMore }} <span class="btn-arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.paidSocialIcon() }}</span>
        <span class="feature__index">03</span>
        <h3 class="feature__title">Digital Advertising (Facebook, Instagram, Google)</h3>
        <p class="feature__body">End-to-end Facebook, Instagram and Google campaigns, and full social media management that builds a brand and generates leads.</p>
        <a class="btn btn-ghost" href="/en/media-promotion/">{{ t.cta.readMore }} <span class="btn-arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.aiVideoIcon() }}</span>
        <span class="feature__index">04</span>
        <h3 class="feature__title">AI, Video &amp; Content</h3>
        <p class="feature__body">Advanced AI-generated video, brand films and commercials, reels and short-form content, editing and motion graphics — from script to final cut.</p>
        <a class="btn btn-ghost" href="/en/ai-video/">{{ t.cta.readMore }} <span class="btn-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<section class="room room--light">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-animate>Portfolio</span>
      <h2 class="display-heading" style="font-size: var(--step-h1);" data-animate>Selected work</h2>
    </div>
    <div class="featured-works-grid" data-animate-group>
      {% for work in works %}
        {% if work.featured %}{{ cards.featuredWorkCard(work, "en", t, "/en/") }}{% endif %}
      {% endfor %}
    </div>
    <div class="center-col" style="margin-block-start: var(--space-2xl);">
      <a class="btn btn-primary" href="/en/works/">{{ t.cta.seeWorks }} <span class="btn-arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="room room--mid" data-quote-carousel>
  <div class="container">
    <div class="quote">
      <span class="quote__mark" aria-hidden="true">”</span>
      <div class="quote__viewport">
        <blockquote class="quote__slide is-active" data-quote-slide>
          <p class="quote__text">Extremely happy: with the speed of response, the creative, the campaigns, and of course the growing number of bookings!</p>
          <footer class="quote__author"><strong>Carmel Maternity Hotel</strong> · Paid media client</footer>
        </blockquote>
        <blockquote class="quote__slide" data-quote-slide>
          <p class="quote__text">Incredibly talented, and a real pleasure to work with. Highly recommend!</p>
          <footer class="quote__author"><strong>Limor Garber</strong> · Marketing Manager, Tempo Beverages</footer>
        </blockquote>
        <blockquote class="quote__slide" data-quote-slide>
          <p class="quote__text">A very professional, attentive studio with a wide range of capabilities. Highly recommended.</p>
          <footer class="quote__author"><strong>Roy Arbel</strong> · Brand Manager, XL Energy</footer>
        </blockquote>
        <blockquote class="quote__slide" data-quote-slide>
          <p class="quote__text">A very professional studio with excellent service. We've worked with them for years. Highly recommend.</p>
          <footer class="quote__author"><strong>Test InSight</strong> · Long-time client</footer>
        </blockquote>
        <blockquote class="quote__slide" data-quote-slide>
          <p class="quote__text">I went through a few ad agencies before I found Boaz. From the very first conversation I knew I was dealing with a professional. The sponsored posts brought responses, and most importantly: money in the till. Available for any question or request.</p>
          <footer class="quote__author"><strong>Galit Yaakobi</strong> · Bridal Gown Designer</footer>
        </blockquote>
      </div>
      <div class="quote-controls">
        <button class="quote-nav" type="button" data-quote-prev aria-label="Previous testimonial">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="quote-dots" data-quote-dots></div>
        <button class="quote-nav" type="button" data-quote-next aria-label="Next testimonial">
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </div>
</section>

{{ marqueeMacro.clientMarquee(t, buildId) }}

<section class="room room--white">
  <div class="container center-col">
    <h2 class="display-heading" style="font-size: var(--step-h1); max-width: 40rem;" data-animate>{{ t.cta.letsTalk }}</h2>
    <a class="btn btn-primary" style="margin-block-start: var(--space-lg);" href="/en/contact/" data-animate>{{ t.cta.contactButton }} <span class="btn-arrow" aria-hidden="true">→</span></a>
  </div>
</section>
