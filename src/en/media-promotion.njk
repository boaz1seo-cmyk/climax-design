      <div class="feature" data-animate-item>
        <span class="feature__icon">{{ icons.networkIcon() }}</span>
        <h3 class="feature__title">Display network &amp; YouTube</h3>
        <p class="feature__body">Build exposure and brand awareness across websites and videos.</p>
      </div>
    </div>
  </div>
</section>

<section class="room room--light">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" data-animate>Social media</span>
