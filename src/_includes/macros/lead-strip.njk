{% macro leadStrip(lang, business, t, uid, heading) %}
<section class="lead-strip">
  <div class="container lead-strip__inner">
    <p class="lead-strip__heading">{{ heading | default(t.leadStrip.defaultHeading) }}</p>
    <form class="lead-strip__form" data-lead-form novalidate>
      <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off">
      <input type="hidden" name="access_key" value="{{ business.web3forms.accessKey }}">
      <input type="hidden" name="subject" value="{{ 'פנייה מהירה מאתר Climax Design' if lang == 'he' else 'Quick inquiry from the Climax Design website' }}">
      <input type="hidden" name="from_name" value="{{ 'סטריפ ליד — climax-design.co.il' if lang == 'he' else 'Lead strip — climax-design.co.il' }}">
      <input type="hidden" name="redirect" value="{{ (business.url + '/thank-you/') if lang == 'he' else (business.url + '/en/thank-you/') }}">
      <div class="lead-strip__field">
        <label class="visually-hidden" for="lead-name-{{ uid }}">{{ t.form.name }}</label>
        <input type="text" id="lead-name-{{ uid }}" name="name" placeholder="{{ t.leadStrip.namePlaceholder }}" required autocomplete="name">
        <span class="form-error" role="alert"></span>
      </div>
      <div class="lead-strip__field">
        <label class="visually-hidden" for="lead-phone-{{ uid }}">{{ t.form.phone }}</label>
        <input type="tel" id="lead-phone-{{ uid }}" name="phone" placeholder="{{ t.leadStrip.phonePlaceholder }}" required autocomplete="tel">
        <span class="form-error" role="alert"></span>
      </div>
      <button class="btn btn-primary lead-strip__submit" type="submit">{{ t.leadStrip.cta }}</button>
    </form>
  </div>
  <div class="form-status container" data-form-status role="status" aria-live="polite"></div>
</section>
{% endmacro %}
