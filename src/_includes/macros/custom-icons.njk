</svg>
{% endmacro %}

{# ============================================================
   Style-direction exploration — "Strategy" in three aesthetics.
   Shown side by side on /icon-test/ for the client to pick one.
   ============================================================ #}

{# A — "One continuous line": a single unbroken flowing stroke —
   an ascending journey that ties one small knot (the plan) and
   keeps rising. Red: a small dot at the line's end, a signature. #}
{% macro strategyLineArt() %}
<svg class="icon-draw" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false" data-draw-duration="1.2">
  <path class="icon-draw__line"
    d="M5 40 C 12 41.5, 17.5 37.5, 20.8 32.2
       C 23.2 28.2, 23 24.2, 20.4 24.6
       C 17.4 25.1, 17.2 29.2, 20.4 29.8
       C 24.4 30.6, 27.6 26.2, 29.8 21.4
       C 31.8 17, 35 12.4, 39.6 9.8" />
  <circle class="icon-draw__accent" cx="41.6" cy="8.8" r="2" />
</svg>
{% endmacro %}

{# B — "Noble geometry": hairline concentric circles + cardinal
   ticks, luxury-maison symmetry. Red: one thin diagonal —
   the chosen direction cutting through the compass. #}
{% macro strategyGeometric() %}
<svg class="icon-draw" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false" data-draw-duration="1.2">
  <circle class="icon-draw__line" cx="24" cy="24" r="19" />
  <circle class="icon-draw__line" cx="24" cy="24" r="13" />
  <path class="icon-draw__line" d="M24 2 L24 8" />
  <path class="icon-draw__line" d="M24 40 L24 46" />
  <path class="icon-draw__line" d="M2 24 L8 24" />
  <path class="icon-draw__line" d="M40 24 L46 24" />
  <circle class="icon-draw__line" cx="24" cy="24" r="2.2" />
  <path class="icon-draw__accent-line" d="M13.5 34.5 L34.5 13.5" />
</svg>
{% endmacro %}

{# C — "Free sketch": a confident hand — mountain drawn with a
   living, wavering line, a thinner climbing route, and one loose
   red brushstroke flying off the summit. #}
{% macro strategySketch() %}
<svg class="icon-draw" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false" data-draw-duration="1.2">
  <path class="icon-draw__line"
    d="M5 41 C 9.6 34.4, 13.8 25.4, 18.2 17.4
       C 19.7 14.6, 21.4 13.8, 22.8 16.2
       C 26.4 22.4, 30.4 30.2, 34.8 35.6
       C 37.3 38.6, 40.4 40.3, 44 40.6" />
  <path class="icon-draw__line"
    d="M10.5 40 C 15.2 36.4, 15.6 31.2, 18.2 27.6
       C 20.2 24.8, 20.9 21.2, 21 18.6" />
  <path class="icon-draw__accent-line"
    d="M22.8 14.4 C 25.2 11.6, 28 11, 30.4 12.6" />
</svg>
{% endmacro %}

