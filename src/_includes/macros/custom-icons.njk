{# Custom hand-drawn icon system: thin black/white line + one red accent detail.
   Each icon: .icon-draw__line elements draw themselves in on scroll,
   then .icon-draw__accent fades/scales in last. #}

{% macro strategyIcon() %}
<svg class="icon-draw" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  <path class="icon-draw__line" d="M3 27 L9 19 L14 23 L20 11 L25 15 L25 6" />
  <polygon class="icon-draw__accent" points="25,6 31,8.5 25,11" />
</svg>
{% endmacro %}

{% macro paidMediaIcon() %}
<svg class="icon-draw" viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  <path class="icon-draw__line" d="M4 12 L4 20 L20 26 L20 6 Z" />
  <path class="icon-draw__accent-line" d="M23 9 L28 6" />
  <path class="icon-draw__accent-line" d="M24 16 L30 16" />
