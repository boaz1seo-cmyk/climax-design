<!doctype html>
<html lang="{{ lang }}" dir="{{ dir }}" class="no-js">
<head>
{% include "partials/meta.njk" %}
</head>
<body class="{{ bodyClass | default('') }}">
  <a class="skip-link" href="#main">{{ i18n[lang].skipToContent }}</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/whatsapp.njk" %}

  <script src="/assets/js/vendor/gsap.min.js"></script>
  <script src="/assets/js/vendor/ScrollTrigger.min.js"></script>
  <script src="/assets/js/vendor/lenis.min.js"></script>
  <script src="/assets/js/main.js?v={{ buildId }}" defer></script>
  <script src="/assets/js/no-orphans.js?v={{ buildId }}" defer></script>
  <script src="/assets/js/animations.js?v={{ buildId }}" defer></script>
  <script src="/assets/js/reveal.js?v={{ buildId }}" defer></script>
  <script src="/assets/js/interactions.js?v={{ buildId }}" defer></script>
</body>
</html>
